# API de Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Base de Datos
DATABASE_URL=sqlite+aiosqlite:///./data/agency.db

# Configuración FastAPI
CORS_ORIGINS=http://localhost:5173

# Configuración Google Sheets
GOOGLE_SHEETS_ID=tu-sheet-id-aqui
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# Configuración Gmail para notificaciones
GMAIL_SENDER_EMAIL=tu-email@gmail.com
GMAIL_APP_PASSWORD=tu-app-password-aqui
GMAIL_RECIPIENT_EMAIL=email-destino@gmail.com
GMAIL_ENABLED=false

# ─── Discord Bot ─────────────────────────────────────────────────────────────
# 1. Crear bot en: https://discord.com/developers/applications
# 2. En "Bot" → Copy Token → pegar en DISCORD_BOT_TOKEN
# 3. Para los Channel IDs: Discord → Settings → Advanced → Developer Mode ON
#    Click derecho en cada canal → Copy Channel ID
DISCORD_BOT_TOKEN=tu-token-aqui
DISCORD_SERVER_ID=id-del-servidor
DISCORD_CEREBRO_CHANNEL=id-canal-cerebro
DISCORD_MENTE_PAUSADA_CHANNEL=id-canal-mente-pausada
DISCORD_POLT_MOBILIER_CHANNEL=id-canal-polt-mobilier
DISCORD_SISTEMA_JEFE_CHANNEL=id-canal-sistema-jefe
DISCORD_PRUEBAS_CHANNEL=id-canal-pruebas
DISCORD_ENABLED=true
BACKEND_API_URL=http://localhost:8000
